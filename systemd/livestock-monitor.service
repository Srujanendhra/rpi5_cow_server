[Unit]
Description=Livestock RYLR993 LoRa Gateway and Web Server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=livestock
Group=dialout
WorkingDirectory=/opt/livestock-monitor
Environment=LORA_PORT=/dev/serial0
Environment=LORA_BAUD=9600
Environment=LORA_BAND=868000000
Environment=LORA_ADDRESS=2
Environment=LORA_OPMODE=1
Environment=LIVESTOCK_DB=/opt/livestock-monitor/livestock.db
ExecStart=/opt/livestock-monitor/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
